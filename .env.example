# Required by https://hub.arbitron.dev/llms.txt
API_HUB_KEY=

# Optional only: disabled-by-default LLM enrichment is not used by normal runs.
FREE_LLM_API=
FREE_LLM_BASE_URL=http://159.194.241.69:3001/v1
# Override if your gateway uses another model name.
FREE_LLM_MODEL=llama-3.3-70b-versatile

# Runtime
SMARTWALLET_DB=data/smartwallet.db
SMARTWALLET_RAW_DIR=data/raw
SMARTWALLET_REPORT_DIR=data/reports
SMARTWALLET_HTTP_TIMEOUT=60
SMARTWALLET_HTTP_RETRIES=4
SMARTWALLET_CONCURRENCY=8
SMARTWALLET_EPISODE_GAP_SECONDS=21600
SMARTWALLET_MAX_EPISODE_EVENTS=50
SMARTWALLET_BRIDGE_CHECK_MIN_USD=100000

# Terminal authentication (required for remote/production access)
SMARTWALLET_AUTH_TOKEN=
SMARTWALLET_PUBLIC_ORIGIN=https://terminal.example.com
HOST=127.0.0.1
SMARTWALLET_PROVIDER_RPS=4
SMARTWALLET_WALLET_TIMEOUT=600
