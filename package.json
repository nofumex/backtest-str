{
  "name": "backtest-str-terminal",
  "private": true,
  "type": "module",
  "version": "2.0.0",
  "scripts": {
    "postinstall": "node scripts/python.mjs --setup",
    "dev": "concurrently -k -n api,ui -c cyan,magenta \"node scripts/python.mjs -m uvicorn smartwallet.web:app --reload --host 127.0.0.1 --port 8000\" \"vite --host 127.0.0.1\"",
    "build": "vite build",
    "start": "node scripts/python.mjs -m smartwallet.web",
    "test": "node scripts/python.mjs -m pytest -q",
    "test:ui": "playwright test"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
