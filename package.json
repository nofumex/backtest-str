{
  "name": "backtest-str-terminal",
  "private": true,
  "type": "module",
  "version": "2.0.0",
  "scripts": {
    "postinstall": "node scripts/python.mjs -m pip install -e .",
    "dev": "concurrently -k -n api,ui -c cyan,magenta \"node scripts/python.mjs -m uvicorn smartwallet.web:app --reload --host 0.0.0.0 --port 8000\" \"vite --host 0.0.0.0\"",
    "build": "vite build",
    "start": "node scripts/python.mjs -m smartwallet.web",
    "test": "node scripts/python.mjs -m pytest -q"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "vite": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {}
}
